<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.StatisticsDetailActivity">


    <include layout="@layout/toolbar" />

    <ScrollView
        android:overScrollMode="never"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/common_color"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20">

                <ImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="@dimen/dp_60"
                    android:layout_height="@dimen/dp_60"
                    android:src="@drawable/default_avatar" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_3"
                    android:text="momo"
                    android:textColor="@color/black"
                    android:textSize="@dimen/sp_18" />

            </LinearLayout>

            <TextView
                android:id="@+id/month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_20"
                android:text="03月账单"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_16" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_20"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本月结余"
                        android:textColor="#666666"
                        android:textSize="@dimen/sp_13" />

                    <TextView
                        android:id="@+id/cashSurplus"
                        android:layout_marginTop="@dimen/dp_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="61925"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_20" />

                </LinearLayout>

                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_20"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上月结余"
                        android:textColor="#666666"
                        android:textSize="@dimen/sp_13" />


                    <TextView
                        android:id="@+id/lastCashSurplus"
                        android:layout_marginTop="@dimen/dp_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="61925"
                        android:textColor="#999999"
                        android:textSize="@dimen/sp_20" />

                </LinearLayout>

            </LinearLayout>

            <com.android.wealth.view.ProgressView
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_8"
                android:layout_marginStart="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginEnd="@dimen/dp_15"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_15"
                android:layout_marginTop="@dimen/dp_13"
                android:layout_marginRight="@dimen/dp_15">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <com.noober.background.view.BLView
                        android:layout_width="@dimen/dp_9"
                        android:layout_height="@dimen/dp_9"
                        app:bl_corners_radius="@dimen/dp_4_5"
                        app:bl_solid_color="#FC3C3E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:includeFontPadding="false"
                        android:text="收入"
                        android:textColor="#ff888888"
                        android:textSize="@dimen/sp_14" />

                    <TextView
                        android:id="@+id/cashIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:includeFontPadding="false"
                        android:text="7467.98万"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_14" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center">

                    <com.noober.background.view.BLView
                        android:layout_width="@dimen/dp_9"
                        android:layout_height="@dimen/dp_9"
                        app:bl_corners_radius="@dimen/dp_4_5"
                        app:bl_solid_color="@color/common_color" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:includeFontPadding="false"
                        android:text="支出"
                        android:textColor="#ff888888"
                        android:textSize="@dimen/sp_14" />

                    <TextView
                        android:id="@+id/cashExport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:includeFontPadding="false"
                        android:text="7467.98万"
                        android:textColor="#ff333333"
                        android:textSize="@dimen/sp_14" />

                </LinearLayout>


            </LinearLayout>

           <LinearLayout
               android:layout_marginTop="@dimen/dp_15"
               android:id="@+id/incomeLayout"
               android:orientation="vertical"
               android:layout_width="match_parent"
               android:layout_height="wrap_content">

               <View
                   android:background="@color/gray_line"
                   android:layout_width="match_parent"
                   android:layout_height="@dimen/dp_7"/>

               <TextView
                   android:textColor="@color/black"
                   android:layout_marginTop="@dimen/dp_15"
                   android:layout_marginStart="@dimen/dp_20"
                   android:text="收入"
                   android:textSize="@dimen/sp_16"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"/>

               <LinearLayout
                   android:layout_marginTop="@dimen/dp_15"
                   android:layout_marginStart="@dimen/dp_20"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:orientation="vertical">

                   <TextView
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="总收入"
                       android:textColor="#666666"
                       android:textSize="@dimen/sp_13" />

                   <TextView
                       android:id="@+id/monthIncome"
                       android:layout_marginTop="@dimen/dp_4"
                       android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       android:text="61925"
                       android:textColor="@color/black"
                       android:textSize="@dimen/sp_20" />

               </LinearLayout>

               <LinearLayout
                   android:orientation="vertical"
                   android:id="@+id/incomeContainer"
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"/>

           </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/dp_15"
                android:id="@+id/exportLayout"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:background="@color/gray_line"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_7"/>

                <TextView
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/dp_15"
                    android:layout_marginStart="@dimen/dp_20"
                    android:text="支出"
                    android:textSize="@dimen/sp_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:layout_marginTop="@dimen/dp_15"
                    android:layout_marginStart="@dimen/dp_20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="总支出"
                        android:textColor="#666666"
                        android:textSize="@dimen/sp_13" />

                    <TextView
                        android:id="@+id/monthExport"
                        android:layout_marginTop="@dimen/dp_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="61925"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_20" />

                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/exportContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</LinearLayout>