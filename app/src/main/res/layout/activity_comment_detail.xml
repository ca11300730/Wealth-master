<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activity.CommentDetailActivity">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/base_action_bar_height"
        android:background="@color/common_color">

        <View
            android:id="@+id/back"
            android:layout_marginStart="@dimen/dp_15"
            android:layout_gravity="center_vertical"
            android:background="@drawable/arrow_back"
            android:layout_width="@dimen/dp_30"
            android:layout_height="@dimen/dp_30"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="详情"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_19" />

        <TextView
            android:id="@+id/toAsk"
            android:layout_marginEnd="@dimen/dp_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="center"
            android:text="去评论"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_16" />

    </FrameLayout>


    <com.noober.background.view.BLConstraintLayout
        android:background="@color/common_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_14"
        >

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_gravity="center"
            android:src="@drawable/default_avatar"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="123"
            android:textColor="@color/color_406599"
            android:textSize="15.0sp"
            app:layout_constraintLeft_toRightOf="@id/iv_avatar" />

        <TextView
            android:layout_marginTop="@dimen/dp_5"
            android:text="7小时前7小时前7小时前7小时前7小时前7小时前7小时前7小时前"
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dip"
            android:maxLines="8"
            android:textColor="@color/black"
            android:textSize="16.0sp"
            app:layout_constraintLeft_toLeftOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_name" />

        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:text="7小时前"
            android:textColor="@color/color_505050"
            android:textSize="@dimen/sp_12"
            app:layout_constraintLeft_toLeftOf="@id/tv_content"
            app:layout_constraintTop_toBottomOf="@id/tv_content" />


    </com.noober.background.view.BLConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:paddingTop="@dimen/dp_10"
        android:overScrollMode="never"
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />


</LinearLayout>