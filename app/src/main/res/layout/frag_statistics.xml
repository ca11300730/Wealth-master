<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.noober.background.view.BLLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_15"
        android:layout_marginBottom="@dimen/dp_20"
        android:orientation="vertical"
        android:padding="@dimen/dp_17"
        app:bl_corners_radius="@dimen/dp_10"
        app:bl_solid_color="@color/common_color">

        <TextView
            android:id="@+id/value0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="年结余"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/cashSurplus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_24"
            android:textStyle="bold"
            tools:text="-529566" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">


                <TextView
                    android:id="@+id/value1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="年收入"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/cashIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5"
                    android:textColor="@color/black"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    tools:text="-529566" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">


                <TextView
                    android:id="@+id/value2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="年支出"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/cashExport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_5"
                    android:textColor="@color/black"
                    android:textSize="@dimen/sp_15"
                    android:textStyle="bold"
                    tools:text="-529566" />

            </LinearLayout>

        </LinearLayout>

    </com.noober.background.view.BLLinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center">

        <TextView
            android:textSize="@dimen/sp_13"
            android:id="@+id/value3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="center"
            android:text="年份" />


        <TextView
            android:textSize="@dimen/sp_13"
            android:id="@+id/value4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:gravity="start"
            android:text="年收入" />

        <TextView
            android:textSize="@dimen/sp_13"
            android:id="@+id/value5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="年支出" />

        <TextView
            android:textSize="@dimen/sp_13"
            android:id="@+id/value6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="年结余" />

        <View
            android:id="@+id/value7"
            android:layout_width="@dimen/dp_10"
            android:layout_height="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_20"
            android:background="@mipmap/right_arrow"
            android:gravity="center" />

    </LinearLayout>

    <View
        android:layout_marginTop="@dimen/dp_5"
        android:background="@color/gray_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0_7"/>


   <ScrollView
       android:layout_width="match_parent"
       android:layout_height="match_parent">

       <FrameLayout
           android:layout_width="match_parent"
           android:layout_height="match_parent">

           <LinearLayout
               android:orientation="vertical"
               android:id="@+id/container"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"/>

           <include layout="@layout/include_empty_layout"
               android:id="@+id/emptyLayout"
               />


       </FrameLayout>

   </ScrollView>


</LinearLayout>